---
import Navlink from "./ui/Navlink.astro";
import Button from "./ui/Button.astro";

const links = [
  { href: "/#about", label: "About" },
  { href: "/#projects", label: "Work" },
  { href: "https://azp-blog.pages.dev/", label: "Blog" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 bg-bg border-b border-primary/10">
  <div
    class="max-w-6xl mx-auto px-5 md:px-8 h-14 flex items-center justify-between"
  >
    <a href="/" class="font-heading font-semibold text-primary text-lg">Ivan</a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      {links.map((link) => <Navlink href={link.href} label={link.label} />)}
    </nav>

    <div class="hidden md:block">
      <Button
        href="mailto:anandazulvansyahputra@gmail.com"
        label="Email Me"
        target="_blank"
      />
    </div>

    <!-- Hamburger -->
    <button
      id="hamburger"
      class="md:hidden cursor-pointer text-primary"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg
        id="icon-open"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-6"
      >
        <path d="M4 6H20M7 12H20M13 18H20"></path>
      </svg>
      <svg
        id="icon-close"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-6 hidden"
      >
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Nav -->
  <nav
    id="mobile-nav"
    class="md:hidden overflow-hidden max-h-0 transition-[max-height] duration-300 ease-in-out border-t border-primary/10"
  >
    <div class="max-w-5xl mx-auto px-5 py-6 flex flex-col gap-6">
      {links.map((link) => <Navlink href={link.href} label={link.label} />)}
      <Button
        href="mailto:anandazulvansyahputra@gmail.com"
        label="Email Me"
        target="_blank"
        extraClasses="w-fit"
      />
    </div>
  </nav>
</header>

<script>
  function setupMenu() {
    const hamburger = document.getElementById("hamburger");
    const mobileNav = document.getElementById("mobile-nav");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");

    if (!hamburger || !mobileNav) return;

    let open = false;

    function toggle() {
      open = !open;
      mobileNav!.style.maxHeight = open ? mobileNav!.scrollHeight + "px" : "0";
      iconOpen!.classList.toggle("hidden", open);
      iconClose!.classList.toggle("hidden", !open);
      hamburger!.setAttribute("aria-expanded", String(open));
    }

    hamburger.addEventListener("click", toggle);

    mobileNav.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        if (open) toggle();
      });
    });
  }

  setupMenu();
  document.addEventListener("astro:page-load", setupMenu);
</script>
