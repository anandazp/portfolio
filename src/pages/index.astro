---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Section from "../components/Section.astro";
import Card from "../components/ui/Card.astro";

const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((p) => p.data.order > 0)
  .sort((a, b) => b.data.order - a.data.order);

const experiences = [
  {
    company: "Methodly",
    position: "Backend Developer (Intern)",
    startDate: "Jan 2026",
    endDate: "Mar 2026",
  },
];

const services = [
  "01. Web Development",
  "02. Landing Page",
  "03. CMS Integration",
];

const testimonials = [
  {
    quote:
      "He's good, and gets the work done on time. He gets feedbacks and experiments well.",
    name: "Budi Santoso",
    job: "Founder, Ojek",
    photo: null,
  },
  {
    quote:
      "Very professional and responsive. Delivered exactly what we needed.",
    name: "Siti Rahayu",
    job: "Marketing Lead, CariKerja",
    photo: null,
  },
];

const contacts = [
  { label: "email", url: "mailto:anandazulvansyahputra@gmail.com" },
  { label: "facebook", url: "https://facebook.com/azura.van5" },
  { label: "threads", url: "https://threads.com/@azura.van5" },
];
---

<BaseLayout title="Ananda Zulvansyah Putra — Web Developer">
  <Header />
  <main class="max-w-6xl mx-auto px-5 md:px-8">
    <!-- Hero -->
    <section class="py-20 md:py-24">
      <h1
        class="font-heading font-semibold text-xl md:text-2xl lg:text-3xl text-primary leading-tight"
      >
        Ananda <br /> Zulvansyah Putra
      </h1>
      <p class="mt-3 text-secondary text-lg">Web Developer</p>
    </section>

    <!-- About -->
    <Section id="about">
      <div class="grid md:grid-cols-2 gap-5">
        <h2 class="section-title">About</h2>
        <div class="space-y-4">
          <p class="text-secondary text-base leading-relaxed">
            I'm Ivan, a web developer who enjoy turning ideas into functional,
            user friendly and clean website.
          </p>
          <p class="text-secondary text-base leading-relaxed">
            I work primarily with <span class="font-semibold"
              >Astro, Tailwind CSS, and Laravel</span
            > — focused on performance, accessibility, and clean code.
          </p>
        </div>
      </div>
    </Section>

    <!-- Skills -->
    <Section id="skills">
      <div class="grid md:grid-cols-2 gap-5">
        <h2 class="section-title">Skills</h2>
        <div class="flex flex-wrap gap-3">
          {
            [
              {
                name: "HTML",
                svg: `<path d="M1.5 0h21l-1.91 21.563L11.977 24l-8.565-2.438L1.5 0zm7.031 9.75l-.232-2.718 10.059.003.23-2.622L5.412 4.41l.698 8.01h9.126l-.326 3.426-2.91.804-2.955-.81-.188-2.11H6.248l.33 4.171L12 19.351l5.379-1.443.744-8.157H8.531z"/>`,
              },
              {
                name: "CSS",
                svg: `<path d="M1.5 0h21l-1.91 21.563L11.977 24l-8.564-2.438L1.5 0zm17.09 4.413L5.41 4.41l.213 2.622 10.125.002-.255 2.716h-6.64l.24 2.573h6.182l-.366 3.523-2.91.804-2.956-.81-.188-2.11h-2.61l.29 3.855L12 19.288l5.373-1.53L18.59 4.414z"/>`,
              },
              {
