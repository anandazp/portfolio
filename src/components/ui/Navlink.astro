---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive =
  currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<a
  href={href}
  class:list={[
    "font-heading text-base relative after:absolute after:-bottom-0.5 after:left-0 after:h-px after:bg-primary after:transition-all after:duration-300",
    isActive
      ? "after:w-full text-primary"
      : "after:w-0 hover:after:w-full text-secondary",
  ]}
>
  {label}
</a>
