---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  name: string;
  description: string;
  href: string;
}

const { src, alt, name, description, href } = Astro.props;
---

<a
  href={href}
  class="group block border border-primary/20 rounded-sm overflow-hidden hover:border-primary/60 transition-colors duration-300"
>
  <div class="overflow-hidden">
    <Image
      src={src}
      alt={alt}
      class="w-full aspect-video object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
      loading="lazy"
    />
  </div>
  <div class="p-4 space-y-1">
    <p class="font-heading font-medium text-primary flex items-center gap-2">
      {name}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256">
        <path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/>
      </svg>
    </p>
    <p class="text-sm text-secondary">{description}</p>
  </div>
</a>
