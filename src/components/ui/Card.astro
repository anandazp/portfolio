---
import { Image } from "astro:assets";

const { src, alt, title, description } = Astro.props;
---

<div
  class="w-full pb-3 md:pb-5 bg-whitelight space-y-2 rounded border border-blackdark/40 group overflow-hidden"
>
  <Image
    src={src}
    alt={alt}
    class="w-full duration-500 transition-transform ease-in-out group-hover:scale-105"
    loading={"lazy"}
  />

  <div class="w-full px-3 md:px-5 space-y-3 lg:space-y-5">
    <p class="font-medium text-xl md:text-2xl lg:text-3xl">{title}</p>
    <p class="font-inter">{description}</p>
    <slot />
  </div>
</div>
