---
interface Props {
  href: string;
  label: string;
  extraClasses?: string;
}

const { href, label, extraClasses } = Astro.props;
const baseClasses = `inline-block font-inter text-4xl lg:text-xl cursor-pointer
  relative w-fit after:absolute after:-bottom-1 after:left-0 after:h-[2px] hover:after:w-1/2 after:bg-white after:content-[''] after:transition-all
  after:duration-300`;
---

<a href={href} class:list={[baseClasses, extraClasses]}>{label}</a>
