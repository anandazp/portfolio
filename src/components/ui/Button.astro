---
interface Props {
  href?: string;
  label: string;
  variant?: "primary" | "secondary";
  target?: string;
  type?: "button" | "submit";
  extraClasses?: string;
}

const {
  href,
  label,
  variant = "primary",
  target,
  type = "button",
  extraClasses = "",
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 px-5 py-2 text-base font-heading rounded-sm transition-all duration-200 cursor-pointer";
const styles = {
  primary: "bg-primary text-bg hover:opacity-80",
  secondary:
    "border border-primary text-primary hover:bg-primary hover:text-bg",
};
---

{
  href ? (
    <a
      href={href}
      target={target}
      class={`${base} ${styles[variant]} ${extraClasses}`}
    >
      {label}
      <slot />
    </a>
  ) : (
    <button type={type} class={`${base} ${styles[variant]} ${extraClasses}`}>
      {label}
      <slot />
    </button>
  )
}
