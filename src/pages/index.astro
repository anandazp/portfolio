              },
              {
                name: "Astro",
                svg: `<path d="M8.358 20.162c-1.186-1.07-1.532-3.316-1.038-4.944.856 1.026 2.043 1.352 3.272 1.535 1.897.283 3.76.177 5.522-.678.202-.098.388-.229.608-.36.166.473.209.95.151 1.437-.14 1.185-.738 2.1-1.688 2.794-.38.277-.782.525-1.175.787-1.205.804-1.531 1.747-1.078 3.119l.044.148a3.158 3.158 0 0 1-1.407-1.188 3.31 3.31 0 0 1-.544-1.815c-.004-.32-.004-.642-.048-.958-.106-.769-.472-1.113-1.161-1.133-.707-.02-1.267.411-1.415 1.09-.012.053-.028.104-.045.165h.002zm-5.961-4.445s3.24-1.575 6.49-1.575l2.451-7.565c.092-.366.36-.614.662-.614.302 0 .57.248.662.614l2.45 7.565c3.85 0 6.491 1.575 6.491 1.575L16.088.727C15.93.285 15.663 0 15.303 0H8.697c-.36 0-.615.285-.784.727l-5.516 14.99z"/>`,
              },
              {
                name: "PHP",
                svg: `<path d="M7.01 10.207h-.944l-.515 2.648h.838c.556 0 .97-.105 1.242-.314.272-.21.455-.559.55-1.049.092-.47.05-.802-.124-.995-.175-.193-.523-.29-1.047-.29zM12 5.688C5.373 5.688 0 8.514 0 12s5.373 6.313 12 6.313S24 15.486 24 12c0-3.486-5.373-6.312-12-6.312zm-3.26 7.451c-.261.25-.575.438-.917.551-.336.108-.765.164-1.285.164H5.357l-.327 1.681H3.652l1.23-6.326h2.65c.797 0 1.378.209 1.744.628.366.418.476 1.002.33 1.752a2.836 2.836 0 0 1-.305.847 2.54 2.54 0 0 1-.561.703zm4.024.715l.543-2.799c.063-.318.039-.536-.068-.651-.107-.116-.336-.174-.687-.174H11.46l-.704 3.624H9.388l1.23-6.326h1.367l-.327 1.682h1.218c.767 0 1.295.134 1.586.401s.378.7.263 1.299l-.572 2.944h-1.389zm7.597-2.265a2.782 2.782 0 0 1-.305.847 2.54 2.54 0 0 1-.561.703c-.261.25-.575.438-.917.551-.336.108-.765.164-1.286.164h-1.18l-.327 1.681h-1.378l1.23-6.326h2.649c.797 0 1.378.209 1.744.628.366.418.476 1.002.33 1.752zm-2.595-1.382h-.943l-.516 2.648h.838c.557 0 .971-.105 1.242-.314.272-.21.455-.559.551-1.049.092-.47.049-.802-.125-.995s-.523-.29-1.047-.29z"/>`,
              },
              {
                name: "Laravel",
                svg: `<path d="M23.642 5.43a.364.364 0 0 1 .014.1v5.149c0 .135-.073.26-.189.326l-4.323 2.49v4.934a.378.378 0 0 1-.188.326L9.93 23.949a.316.316 0 0 1-.066.027c-.008.002-.016.008-.024.01a.348.348 0 0 1-.192 0c-.011-.002-.02-.008-.03-.012-.02-.008-.042-.014-.062-.025L.533 18.755a.376.376 0 0 1-.189-.326V2.974c0-.033.005-.066.014-.098.003-.012.01-.02.014-.032a.369.369 0 0 1 .023-.058c.004-.013.015-.022.023-.033l.033-.045c.012-.01.025-.018.037-.027.014-.012.027-.024.041-.034h.001L5.044.05a.375.375 0 0 1 .378 0L9.8 2.512h.002c.015.01.027.021.04.033l.038.027c.013.014.02.03.033.045.008.011.02.021.025.033.01.02.017.038.024.058.003.011.01.021.013.032.01.031.014.064.014.098v9.652l3.76-2.164V5.527c0-.033.004-.066.013-.098.003-.01.01-.02.013-.032a.487.487 0 0 1 .024-.059c.007-.012.018-.02.025-.033.012-.015.021-.03.033-.043.012-.012.025-.02.037-.028.014-.011.026-.023.041-.032h.001l4.378-2.462a.377.377 0 0 1 .378 0l4.378 2.462c.015.009.027.021.04.033.013.009.026.016.038.027.013.014.021.029.033.043.008.012.02.021.025.033.01.02.018.04.024.06.006.01.012.021.015.032zm-.74 5.032V6.179l-1.578.908-2.182 1.256v4.283zm-4.742 8.153V14.33l-2.153 1.227-6.154 3.505v4.326zM1.12 3.299v15.084l8.34 4.806v-4.326l-4.322-2.445-.002-.003-.002-.002c-.014-.01-.025-.021-.037-.031-.013-.012-.027-.021-.038-.033l-.001-.001c-.011-.014-.018-.03-.028-.045-.007-.012-.016-.022-.021-.035-.007-.019-.01-.039-.015-.059-.004-.012-.009-.023-.01-.036a.293.293 0 0 1-.004-.052V7.441zm4.373-2.909L1.866 2.91l3.627 2.084 3.627-2.084zm8.832 5.994l-3.627 2.085 3.627 2.084 3.628-2.084zm-8.455 4.841L9.496 9.12 5.87 7.035v4.168zm9.185-5.997l-3.628 2.085v4.168l1.578-.908 2.05-1.177zM5.12 13.414l-2.182-1.256-1.579-.908v4.283l3.761 2.164zm6.109 1.072l-3.76-2.164v4.283l3.76 2.163z"/>`,
              },
              {
                name: "Git",
                svg: `<path d="M23.546 10.93L13.067.452c-.604-.603-1.582-.603-2.188 0L8.708 2.627l2.76 2.76c.645-.215 1.379-.07 1.889.441.516.515.658 1.258.438 1.9l2.658 2.66c.645-.223 1.387-.078 1.9.435.721.72.721 1.884 0 2.604-.719.719-1.881.719-2.6 0-.539-.541-.674-1.337-.404-1.996L12.86 8.955v6.525c.176.086.342.203.488.348.713.721.713 1.883 0 2.6-.719.721-1.889.721-2.609 0-.719-.719-.719-1.879 0-2.598.182-.18.387-.316.605-.406V8.835c-.217-.091-.424-.222-.6-.401-.545-.545-.676-1.342-.396-2.009L7.636 3.7.45 10.881c-.6.605-.6 1.584 0 2.189l10.48 10.477c.604.604 1.582.604 2.186 0l10.43-10.43c.605-.603.605-1.582 0-2.187"/>`,
              },
            ].map((tech) => (
              <div class="flex items-center gap-2 border border-primary/20 rounded px-3 py-1.5">
                <svg
                  role="img"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 fill-secondary shrink-0"
                  aria-label={tech.name}
                  set:html={tech.svg}
                />
                <span class="text-sm text-secondary">{tech.name}</span>
              </div>
            ))
          }
        </div>
      </div>
    </Section>

    <!-- Projects -->
    <Section id="projects">
      <h2 class="section-title mb-10">Projects</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 md:gap-12">
        {
          projects.map((project) => (
            <Card
              src={project.data.image}
              alt={project.data.name}
              name={project.data.name}
              description={project.data.description}
              href={`/projects/${project.slug}`}
            />
          ))
        }
      </div>
    </Section>

    <!-- Experience -->
    <Section id="experience">
      <div class="grid sm:grid-cols-2 gap-10 md:gap-16">
        <h2 class="section-title">Experience</h2>
        <div class="space-y-4">
          {
            experiences.map((exp) => (
              <div>
                <p class="font-heading font-medium  md:text-lg text-primary">
                  {exp.company}
                </p>
                <p class="text-secondary">{exp.position}</p>
                <p class="text-secondary/60 text-sm mt-0.5">
                  {exp.startDate} – {exp.endDate}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </Section>

    <!-- Services -->
    <Section id="services">
      <div class="grid sm:grid-cols-2 gap-10 md:gap-16">
        <h2 class="section-title">Services</h2>
        <div class="space-y-4">
          {
            services.map((service) => (
              <p class=" text-lg text-primary">{service}</p>
            ))
          }
        </div>
      </div>
    </Section>

    <!-- Testimonials -->
    <!-- <Section id="testimonials">
      <h2 class="section-title mb-10">Testimonials</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {
          testimonials.map((t) => (
            <div class="border border-primary/20 rounded-sm p-5 space-y-4">
              <p class="text-secondary text-sm leading-relaxed">"{t.quote}"</p>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary/40 text-xs font-heading shrink-0">
                  {t.photo ? (
                    <img
                      src={t.photo}
                      alt={t.name}
                      class="w-full h-full rounded-full object-cover"
                    />
                  ) : (
                    t.name.charAt(0)
                  )}
                </div>
                <div>
                  <p class="font-heading font-medium text-primary text-sm">
                    {t.name}
                  </p>
                  <p class="text-secondary/60 text-xs">{t.job}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </Section> -->

    <!-- Contact -->
    <Section id="contact">
      <p class="section-title">Get in touch</p>
      <h2
        class="font-heading font-medium text-xl md:text-2xl lg:text-3xl text-primary leading-tight my-5"
      >
        Want to collaborate?
      </h2>
      <p class="text-secondary mb-4">Feel free to reach out</p>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        {
          contacts.map((c) => (
            <a
              href={c.url}
              target="_blank"
              class=" text-secondary hover:text-primary transition-colors duration-200 underline underline-offset-4"
            >
              {c.label}
            </a>
          ))
        }
      </div>
    </Section>
  </main>

  <footer class="border-t border-primary/10">
    <div class="max-w-6xl mx-auto px-5 md:px-8 py-6">
      <p class="text-primary text-xs">
        Copyright {new Date().getFullYear()} Ananda Zulvansyah Putra
      </p>
    </div>
  </footer>
</BaseLayout>
